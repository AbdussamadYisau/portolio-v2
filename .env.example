# Copy to .env.local; never put secrets in NEXT_PUBLIC variables.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Written by: node scripts/connect-spotify.mjs
SPOTIFY_REFRESH_TOKEN=

# Public Strava profile URL and the exact iframe src from its official embed code.
NEXT_PUBLIC_STRAVA_PROFILE_URL= https://www.strava.com/athletes/141584706
NEXT_PUBLIC_STRAVA_EMBED_URL= https://www.strava.com/athletes/141584706/activity-summary/950def5ee2bdb62cbd0527fca1e9479baa627719

# Public Sanity project settings for the photo journal.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Strava API custom card (server only; keep NEXT_PUBLIC_STRAVA_* for fallback).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only when your public display use is permitted by Strava.
STRAVA_PUBLIC_STATS_ENABLED=false

# Separate Sanity project for Selected Work (server-side).
SANITY_WORK_PROJECT_ID=ttil6cux
SANITY_WORK_DATASET=production
